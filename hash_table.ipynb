# Given Array 
arr = [30,34,32,55,60]

# size ofmour hash table
size = 10

# create an empty hash table 
hash_table = [None] * size

#Go through every number in the Array
for num in arr:

      # Calculate the index using hash function 
      index = num % size

      # store the number as calculated index 
      hash_table[index] = num
      
# print the hash table
print(hash_table)

[60, None, 32, None, 34, 55, None, None, None, None]     output

                        
# Given Array 
arr = [30,34,32,55,60] 

# hash table size
size = 10  

# create an empty hash table 
hash_table = [None] * size

# Insert bevery number
for ele in arr:

      # Calculate the index using hash function 
      index = ele % size

      # If index is already occupied
      while hash_table[index] is not None:

            # Move to the next index
            index = (index + 1) % size

      # Store the element at the calculated index
      hash_table[index] = ele

# Print the hash table
print(hash_table)


[30, 60, 32, None, 34, 55, None, None, None, None]    output



arr = [30,34,32,55,60,44,45]

size = 10

hash_table = [None] * size

for num in arr:
    index = num % size

    i = 1

    while hash_table[index] is not None:

        index = (num % size  + i * i) % size  # Quadratic probing

        i += 1
    hash_table [index] = num
print(hash_table)


[30, 60, 32, None, 34, 55, 45, None, 44, None]     output

      
